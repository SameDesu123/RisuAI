{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-capability",
  "description": "Permissions required by the RisuAI Android application.",
  "local": true,
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA",
        "$APPDATA/*",
        "$APPDATA/**/*",
        "$DOWNLOAD/*"
      ]
    },
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*/*"
        },
        {
          "url": "https://*/**/*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*/**/*"
        },
        {
          "url": "http://*:**"
        }
      ]
    },
    "os:default",
    "process:default",
    "shell:allow-open",
    "deep-link:default",
    "notification:default"
  ]
}
